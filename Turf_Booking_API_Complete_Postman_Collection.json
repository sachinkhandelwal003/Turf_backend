{
  "info": {
    "_postman_id": "turf-booking-api-complete-v1",
    "name": "Turf Booking API - Complete",
    "description": "Complete Postman Collection for Turf Booking Application with all endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"phone\": \"9876543210\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"]},
            "description": "Register a new user"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/auth/login", "host": ["{{baseUrl}}"], "path": ["api", "auth", "login"]},
            "description": "Login to get access token"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/auth/logout", "host": ["{{baseUrl}}"], "path": ["api", "auth", "logout"]},
            "description": "Logout user"
          }
        },
        {
          "name": "Get Profile",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"]},
            "description": "Get current user's profile"
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "formdata", "formdata": [
              {"key": "name", "value": "John Updated", "type": "text"},
              {"key": "profilePhoto", "type": "file"}
            ]},
            "url": {"raw": "{{baseUrl}}/api/auth/profile", "host": ["{{baseUrl}}"], "path": ["api", "auth", "profile"]},
            "description": "Update user profile with optional photos"
          }
        },
        {
          "name": "Update Password",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"currentPassword\": \"oldpass123\",\n  \"newPassword\": \"newpass123\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/auth/update-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "update-password"]}
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"email\": \"user@example.com\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/auth/forgot-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "forgot-password"]}
          }
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"token\": \"reset_token_here\",\n  \"newPassword\": \"newpassword123\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/auth/reset-password", "host": ["{{baseUrl}}"], "path": ["api", "auth", "reset-password"]}
          }
        }
      ]
    },
    {
      "name": "2. Turfs/Venues",
      "item": [
        {
          "name": "Get All Turfs",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/turfs", "host": ["{{baseUrl}}"], "path": ["api", "turfs"]}}
        },
        {
          "name": "Get Turf by ID",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/turfs/:id", "host": ["{{baseUrl}}"], "path": ["api", "turfs", ":id"], "variable": [{"key": "id", "value": "turf_object_id"}]}}
        },
        {
          "name": "Create Turf",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "formdata", "formdata": [
              {"key": "name", "value": "My Turf", "type": "text"},
              {"key": "sport", "value": "Cricket", "type": "text"},
              {"key": "images", "type": "file"}
            ]},
            "url": {"raw": "{{baseUrl}}/api/turfs", "host": ["{{baseUrl}}"], "path": ["api", "turfs"]}
          }
        },
        {
          "name": "Update Turf",
          "request": {
            "method": "PUT",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/turfs/:id", "host": ["{{baseUrl}}"], "path": ["api", "turfs", ":id"], "variable": [{"key": "id", "value": "turf_object_id"}]}
          }
        },
        {
          "name": "Get My Turfs (Admin)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/turfs/my/all", "host": ["{{baseUrl}}"], "path": ["api", "turfs", "my", "all"]}
          }
        }
      ]
    },
    {
      "name": "3. Bookings",
      "item": [
        {
          "name": "Create Booking",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"turfId\": \"turf_object_id\",\n  \"sport\": \"Cricket\",\n  \"date\": \"2026-06-02\",\n  \"slots\": [\"10:00 - 11:00\"],\n  \"courts\": [\"Court 1\"],\n  \"price\": 500\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/bookings", "host": ["{{baseUrl}}"], "path": ["api", "bookings"]}
          }
        },
        {
          "name": "Get My Bookings",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/bookings/my?filter=upcoming", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "my"], "query": [{"key": "filter", "value": "upcoming"}]}
          }
        },
        {
          "name": "Get All Bookings (Superadmin)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/bookings/all", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "all"]}
          }
        },
        {
          "name": "Get My Turf Bookings (Admin)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/bookings/admin/my-turfs", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "admin", "my-turfs"]}
          }
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/bookings/:id", "host": ["{{baseUrl}}"], "path": ["api", "bookings", ":id"], "variable": [{"key": "id", "value": "booking_object_id"}]}
          }
        },
        {
          "name": "Update Booking Status",
          "request": {
            "method": "PATCH",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {"mode": "raw", "raw": "{\n  \"status\": \"confirmed\"\n}"},
            "url": {"raw": "{{baseUrl}}/api/bookings/:id/status", "host": ["{{baseUrl}}"], "path": ["api", "bookings", ":id", "status"], "variable": [{"key": "id", "value": "booking_object_id"}]}
          }
        },
        {
          "name": "Delete Booking",
          "request": {
            "method": "DELETE",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/bookings/:id", "host": ["{{baseUrl}}"], "path": ["api", "bookings", ":id"], "variable": [{"key": "id", "value": "booking_object_id"}]}
          }
        },
        {
          "name": "Check Availability",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/bookings/check-availability?turfId=turf_id&date=2026-06-02", "host": ["{{baseUrl}}"], "path": ["api", "bookings", "check-availability"], "query": [
              {"key": "turfId", "value": "turf_object_id"},
              {"key": "date", "value": "2026-06-02"}
            ]}
          }
        }
      ]
    },
    {
      "name": "4. Matches (NEW!)",
      "item": [
        {
          "name": "Create Match",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}, {"key": "Authorization", "value": "Bearer {{token}}"}],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"turf\": \"turf_object_id\",\n  \"title\": \"Sunday Cricket Match\",\n  \"description\": \"Friendly match\",\n  \"sport\": \"Cricket\",\n  \"date\": \"2026-06-02\",\n  \"startTime\": \"10:00\",\n  \"endTime\": \"12:00\",\n  \"totalPlayersNeeded\": 12,\n  \"pricePerPlayer\": 200,\n  \"isPrivate\": false\n}"
            },
            "url": {"raw": "{{baseUrl}}/api/matches", "host": ["{{baseUrl}}"], "path": ["api", "matches"]}
          }
        },
        {
          "name": "Get Open Matches (with Search)",
          "request": {
            "method": "GET",
            "url": {"raw": "{{baseUrl}}/api/matches?sport=Cricket&city=Delhi&search=Sunday", "host": ["{{baseUrl}}"], "path": ["api", "matches"], "query": [
              {"key": "sport", "value": "Cricket"},
              {"key": "city", "value": "Delhi"},
              {"key": "search", "value": "Sunday"}
            ]}
          }
        },
        {
          "name": "Get Match by ID",
          "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/matches/:id", "host": ["{{baseUrl}}"], "path": ["api", "matches", ":id"], "variable": [{"key": "id", "value": "match_object_id"}]}}
        },
        {
          "name": "Join Match",
          "request": {
            "method": "POST",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/matches/:id/join", "host": ["{{baseUrl}}"], "path": ["api", "matches", ":id", "join"], "variable": [{"key": "id", "value": "match_object_id"}]}
          }
        },
        {
          "name": "Get My Hosted Matches (Host History - NEW!)",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/matches/host/my?status=completed", "host": ["{{baseUrl}}"], "path": ["api", "matches", "host", "my"], "query": [{"key": "status", "value": "completed"}]}
          }
        },
        {
          "name": "Get Admin Matches",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{token}}"}],
            "url": {"raw": "{{baseUrl}}/api/matches/admin/all", "host": ["{{baseUrl}}"], "path": ["api", "matches", "admin", "all"]}
          }
        }
      ]
    },
    {
      "name": "5. Tournaments",
      "item": [
        {"name": "Get All Tournaments", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/tournaments", "host": ["{{baseUrl}}"], "path": ["api", "tournaments"]}}},
        {"name": "Get Tournament by ID", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/tournaments/:id", "host": ["{{baseUrl}}"], "path": ["api", "tournaments", ":id"]}}}
      ]
    },
    {
      "name": "6. Dashboard",
      "item": [
        {"name": "Get Dashboard Stats", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/dashboard/stats", "host": ["{{baseUrl}}"], "path": ["api", "dashboard", "stats"]}}}
      ]
    },
    {
      "name": "7. Reviews",
      "item": [{"name": "Get Reviews", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/reviews", "host": ["{{baseUrl}}"], "path": ["api", "reviews"]}}}]
    },
    {
      "name": "8. Masters",
      "item": [{"name": "Get Masters", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/masters", "host": ["{{baseUrl}}"], "path": ["api", "masters"]}}}]
    },
    {
      "name": "9. Settlements",
      "item": [{"name": "Get Settlements", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/settlements", "host": ["{{baseUrl}}"], "path": ["api", "settlements"]}}}]
    },
    {
      "name": "10. Venue Leads",
      "item": [{"name": "Get Venue Leads", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/venue-leads", "host": ["{{baseUrl}}"], "path": ["api", "venue-leads"]}}}]
    },
    {
      "name": "11. Chat",
      "item": [{"name": "Get Chat Messages", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/chat", "host": ["{{baseUrl}}"], "path": ["api", "chat"]}}}]
    },
    {
      "name": "12. Settings",
      "item": [{"name": "Get Settings", "request": {"method": "GET", "url": {"raw": "{{baseUrl}}/api/settings", "host": ["{{baseUrl}}"], "path": ["api", "settings"]}}}]
    },
    {
      "name": "13. Billing",
      "item": [{"name": "Get Billing Data", "request": {"method": "GET", "header": [{"key": "Authorization", "value": "Bearer {{token}}"}], "url": {"raw": "{{baseUrl}}/api/billing", "host": ["{{baseUrl}}"], "path": ["api", "billing"]}}}]
    }
  ],
  "variable": [
    {"key": "baseUrl", "value": "http://localhost:5001", "type": "string"},
    {"key": "token", "value": "your_bearer_token_here", "type": "string"}
  ]
}
