          "maxTeams": 16
        }
      },
      "registerTournament": {
        "method": "POST",
        "path": "/tournaments/{id}/register",
        "requiresAuth": true,
        "description": "Register for tournament",
        "testData": {
          "id": "507f1f77bcf86cd799439011",
          "body": {
            "teamName": "Elite Strikers",
            "teamSize": 11,
            "contactEmail": "team@example.com",
            "contactPhone": "9876543210"
          }
        }
      },
      "approveTournament": {
        "method": "PATCH",
        "path": "/tournaments/{id}/approve",
        "requiresAuth": true,
        "requiresPermission": "approve_tournaments",
